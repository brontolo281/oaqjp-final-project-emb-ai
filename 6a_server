from flask import Flask, render_template, request
from EmotionDetection.emotion_detection import emotion_detector

# Inizializzazione dell'applicazione Flask
app = Flask("Emotion Detector")

@app.route("/emotionDetector")
def sent_analyzer():
    # Recupera il testo passato come parametro GET (textToAnalyze)
    text_to_analyze = request.args.get('textToAnalyze')
    
    # Esegue l'analisi tramite la funzione del pacchetto
    response = emotion_detector(text_to_analyze)
    
    # Estrazione delle singole emozioni e dell'emozione dominante
    anger = response.get('anger')
    disgust = response.get('disgust')
    fear = response.get('fear')
    joy = response.get('joy')
    sadness = response.get('sadness')
    dominant_emotion = response.get('dominant_emotion')

    # Se per qualsiasi motivo il testo non è valido o l'API restituisce None
    if dominant_emotion is None:
        return "Invalid text! Please try again!"

    # Restituisce la risposta formattata esattamente come richiesto dalla traccia
    return (
        f"For the given statement, the system response is "
        f"'anger': {anger}, 'disgust': {disgust}, 'fear': {fear}, "
        f"'joy': {joy} and 'sadness': {sadness}. "
        f"The dominant emotion is {dominant_emotion}."
    )

@app.route("/")
def render_index_page():
    # Renderizza la pagina HTML principale presente nella cartella templates/
    return render_template('index.html')

if __name__ == "__main__":
    # Avvia l'applicazione su localhost alla porta 5000
    app.run(host="0.0.0.0", port=5000)